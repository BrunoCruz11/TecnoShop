<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                 https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="tecnoshopPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.tecnoshop.model.Usuario</class>
        <class>com.tecnoshop.model.Compra</class>
        <class>com.tecnoshop.model.Proveedor</class>
        <class>com.tecnoshop.model.Producto</class>
        <class>com.tecnoshop.model.Detalle_compra</class>

        <properties>
            <!-- Conexión a la base de datos (coincide con docker-compose.yml) -->
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5433/tecnoshop_db"/>
            <property name="jakarta.persistence.jdbc.user" value="tecnoshop"/>
            <property name="jakarta.persistence.jdbc.password" value="tecnoshop"/>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>

            <!-- Dialecto: Hibernate 6 lo detecta solo, pero se puede fijar explícitamente -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>

            <!-- Crea/actualiza las tablas automáticamente en desarrollo.
                 Cambiar a "validate" o "none" en producción. -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>

            <!-- Muestra el SQL generado en consola (útil para aprender/depurar) -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>

</persistence>
