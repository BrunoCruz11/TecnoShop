<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                 https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="tecnoshopPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.tecnoshop.model.Usuario</class>
        <class>com.tecnoshop.model.Compra</class>
        <class>com.tecnoshop.model.Proveedor</class>
        <class>com.tecnoshop.model.Producto</class>
        <class>com.tecnoshop.model.Detalle_compra</class>

        <properties>
            <!-- La URL, el usuario y la contraseña de la base NO van aca: los pone HibernateUtil
                 a partir de variables de entorno (ver util/Config.java). -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>

            <!-- El esquema lo crean las migraciones de Flyway (src/main/resources/db/migration).
                 Hibernate solo valida que las entidades coincidan con las tablas; si no coinciden, no arranca. -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>

            <!-- Pool de conexiones HikariCP (el pool que trae Hibernate por defecto no es para produccion) -->
            <property name="hibernate.hikari.maximumPoolSize" value="10"/>
            <property name="hibernate.hikari.minimumIdle" value="2"/>

            <!-- Mostrar el SQL se activa con la variable de entorno MOSTRAR_SQL=true -->
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>

</persistence>
