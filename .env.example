# Copiar a .env (que NO se sube a git) y completar. Lo usa docker-compose.prod.yml.

# Base de datos
DB_USER=tecnoshop
DB_PASSWORD=cambiar-por-una-contraseña-larga
DB_NAME=tecnoshop_db

# Clave para firmar las sesiones: minimo 32 caracteres, secreta y distinta en cada instalacion.
# Se puede generar con:  openssl rand -base64 48
JWT_SECRET=

# Duracion de la sesion en horas
JWT_HORAS=8

# Primer usuario. Solo se usa si todavia no hay ningun usuario; despues se puede borrar de aca.
ADMIN_EMAIL=admin@tu-dominio.com
ADMIN_PASSWORD=cambiar-esta-contraseña

# true para cargar los productos de ejemplo (solo para una demo)
CARGAR_DATOS=false

# Puerto donde queda publicada la aplicacion
PUERTO_WEB=80
